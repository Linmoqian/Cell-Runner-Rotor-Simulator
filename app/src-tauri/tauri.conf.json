{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cell Runner-Rotor Simulator",
  "version": "0.1.0",
  "identifier": "io.cell-runner-rotor.simulator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3223",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cell Runner-Rotor Simulator",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
